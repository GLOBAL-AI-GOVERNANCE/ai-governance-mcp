{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:global-ai-governance:agentic-ai-governance:schema:claims-register:1.0.0",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "Agentic AI Governance Claims Register",
  "type": "object",
  "required": [
    "register_version",
    "claims"
  ],
  "properties": {
    "register_version": {
      "const": "1.0.0"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "statusDelivery": {
      "enum": [
        "PROPOSED",
        "DEFINED",
        "SHIPPED"
      ]
    },
    "statusEvidence": {
      "enum": [
        "NOT_YET_ESTABLISHED",
        "VERIFIED"
      ]
    },
    "claim": {
      "type": "object",
      "required": [
        "claim_id",
        "claim_kind",
        "statement",
        "evidence_status",
        "verification_scope",
        "supporting_artifacts",
        "evidence_refs",
        "limitations",
        "permitted_wording",
        "prohibited_wording"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
        },
        "claim_kind": {
          "enum": [
            "CAPABILITY",
            "SPECIFICATION",
            "TOOLING",
            "ARCHITECTURAL_DECISION",
            "PUBLIC_POSITION",
            "ASSURANCE_BOUNDARY",
            "EXTERNAL_FACT",
            "ANALYTIC_INFERENCE"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "delivery_status": {
          "$ref": "#/$defs/statusDelivery"
        },
        "evidence_status": {
          "$ref": "#/$defs/statusEvidence"
        },
        "verification_scope": {
          "type": "string",
          "minLength": 1
        },
        "verification_method": {
          "type": "string",
          "minLength": 1
        },
        "last_verified": {
          "type": "string",
          "format": "date"
        },
        "supporting_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "permitted_wording": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "prohibited_wording": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_kind": {
                "const": "EXTERNAL_FACT"
              }
            },
            "required": [
              "claim_kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "delivery_status"
              ]
            }
          },
          "else": {
            "required": [
              "delivery_status"
            ],
            "properties": {
              "supporting_artifacts": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_status": {
                "const": "VERIFIED"
              }
            },
            "required": [
              "evidence_status"
            ]
          },
          "then": {
            "required": [
              "verification_method",
              "last_verified"
            ],
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
