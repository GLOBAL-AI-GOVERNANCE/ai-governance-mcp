{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:global-ai-governance:agentic-ai-governance:schema:schema-catalog:1.0.0",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "Agentic AI Governance Schema Catalog",
  "type": "object",
  "required": [
    "catalog_version",
    "catalog_id",
    "entries"
  ],
  "properties": {
    "$comment": {
      "const": "SPDX-License-Identifier: Apache-2.0"
    },
    "catalog_version": {
      "const": "1.0.0"
    },
    "catalog_id": {
      "const": "urn:global-ai-governance:agentic-ai-governance:schema-catalog:1.0.0"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schema_file",
          "schema_id",
          "artifact_kind",
          "artifact_version",
          "id_strategy",
          "status",
          "introduced_in",
          "supersedes",
          "content_sha256",
          "license"
        ],
        "properties": {
          "schema_file": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$"
          },
          "schema_id": {
            "type": "string",
            "format": "uri"
          },
          "artifact_kind": {
            "enum": [
              "PROTOCOL_SCHEMA",
              "GOVERNANCE_SCHEMA"
            ]
          },
          "artifact_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
          },
          "id_strategy": {
            "enum": [
              "TAGGED_RAW_GITHUB",
              "URN"
            ]
          },
          "status": {
            "enum": [
              "ACTIVE",
              "DEPRECATED"
            ]
          },
          "introduced_in": {
            "type": "string",
            "minLength": 1
          },
          "supersedes": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "license": {
            "enum": [
              "Apache-2.0",
              "CC-BY-4.0"
            ]
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
